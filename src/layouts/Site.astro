---
// Site layout: the RPG menu theme. Side menu with the contact block at its foot (a fold-out menu on phones),
// living background, and the page script that drives them.
import '../styles/global.css';
import '../styles/theme.css';
import { site } from '../data/site.mjs';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.headline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Link previews (LinkedIn, WhatsApp, X): absolute URLs built from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/games/', label: 'Games' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' : path.startsWith(h);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oxanium:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600&display=swap" />
    <script is:inline>document.documentElement.classList.add('js-nav');</script>
  </head>
  <body>
    <!-- Living background: a slow drifting glow, plus fine light strands and motes drawn on a canvas.
         Decorative; with reduced motion the canvas draws one still frame. -->
    <div class="rpg-fx" aria-hidden="true"><i></i><canvas></canvas></div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <button type="button" class="nav-toggle" aria-controls="nav-panel" aria-expanded="false">
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span><span>Menu</span>
        </button>
        <div class="nav-panel" id="nav-panel">
          <nav class="site-nav" aria-label="Main">
            {nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
          <div class="rpg-contact">
            <h2>Contact</h2>
            <p class="contact-loc">Based in {site.location}. Open to remote roles and relocation.</p>
            <ul class="contact-list">
              <li>
                <a href={`mailto:${site.email}`}>
                  <span class="contact-ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1.5 3h13a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5Zm.9 1.2L8 8.6l5.6-4.4H2.4ZM14 5.2 8.3 9.7a.5.5 0 0 1-.6 0L2 5.2v6.6h12V5.2Z" /></svg></span>
                  <span class="contact-txt"><b>Email</b><small>{site.email}</small></span>
                </a>
              </li>
              <li>
                <a href={site.links.linkedin}>
                  <span class="contact-ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z" /></svg></span>
                  <span class="contact-txt"><b>LinkedIn</b></span>
                </a>
              </li>
              <li>
                <a href={site.links.github}>
                  <span class="contact-ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg></span>
                  <span class="contact-txt"><b>GitHub</b></span>
                </a>
              </li>
              <li>
                <a href={site.links.itch}>
                  <!-- Simplified storefront drawn for this mockup, standing in for the itch.io logo. -->
                  <span class="contact-ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 2h12l1.2 3.2c0 1-.8 1.8-1.8 1.8-.9 0-1.6-.6-1.8-1.4C11.4 6.4 10.7 7 9.8 7S8.2 6.4 8 5.6C7.8 6.4 7.1 7 6.2 7s-1.6-.6-1.8-1.4C4.2 6.4 3.5 7 2.6 7 1.6 7 .8 6.2.8 5.2L2 2Zm0 6.1c.2 0 .4.1.6.1.7 0 1.3-.2 1.8-.6.5.4 1.1.6 1.8.6s1.3-.2 1.8-.6c.5.4 1.1.6 1.8.6s1.3-.2 1.8-.6c.5.4 1.1.6 1.8.6.2 0 .4 0 .6-.1V14H10v-3.5H6V14H2V8.1Z" /></svg></span>
                  <span class="contact-txt"><b>itch.io</b></span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>{site.name} · {site.headline}</span>{' · '}<a href={site.links.github}>GitHub</a>{' · '}<a href={site.links.linkedin}>LinkedIn</a>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Phones: the menu and the contact block fold into a button on a bar that stays at the top of the screen.
        const bar = document.querySelector('.site-header .wrap');
        const nav = bar?.querySelector('.site-nav');
        const btn = bar?.querySelector('.nav-toggle');
        if (bar && nav && btn) {
          const root = document.documentElement;
          const setNav = (open) => { root.classList.toggle('nav-open', open); btn.setAttribute('aria-expanded', String(open)); };
          btn.addEventListener('click', () => setNav(!root.classList.contains('nav-open')));
          nav.addEventListener('click', (e) => { if (e.target.closest('a')) setNav(false); });
          addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.classList.contains('nav-open')) { setNav(false); btn.focus(); } });
          document.addEventListener('click', (e) => { if (!bar.contains(e.target)) setNav(false); });
        }

        // Background: a few ribbons of thin green strands that undulate across the screen, and green motes
        // that drift up and twinkle. Drawn at CSS-pixel resolution and capped at ~30 fps to stay light.
        const cv = document.querySelector('.rpg-fx canvas');
        const cx = cv?.getContext('2d');
        if (cx) {
          const TAU = Math.PI * 2;
          // Glow sprite for the motes, drawn once and stamped many times.
          const makeSprite = (core, mid, edge) => {
            const c = document.createElement('canvas');
            c.width = c.height = 32;
            const g2 = c.getContext('2d');
            const g = g2.createRadialGradient(16, 16, 0, 16, 16, 16);
            g.addColorStop(0, core);
            g.addColorStop(0.18, mid);
            g.addColorStop(0.45, edge);
            g.addColorStop(1, 'rgba(0, 0, 0, 0)');
            g2.fillStyle = g;
            g2.fillRect(0, 0, 32, 32);
            return c;
          };
          const green = makeSprite('rgba(225, 255, 235, 1)', 'rgba(120, 255, 180, 0.9)', 'rgba(60, 220, 150, 0.25)');
          const lime = makeSprite('rgba(250, 255, 220, 1)', 'rgba(210, 245, 110, 0.85)', 'rgba(170, 220, 60, 0.2)');

          // A stream of fine light strands, like a loose bundle of fibre: it rises along the right side, bends in
          // the lower right and flows out to the left near the bottom. Every strand follows the same path with its
          // own place in the bundle and its own wave, so strands drift across each other and cross again without
          // tangling. A few glints travel along the strands, and a faint band of light marks the lower flow.
          const N = 26, M = 110;
          const strands = Array.from({ length: N }, (_, i) => {
            const c = Math.random(); // colour: 0 = blue, 1 = sea green
            return {
              k: i / (N - 1) - 0.5,
              ph: Math.random() * TAU,
              f: 2 + Math.random() * 2.2,
              f2: 4.5 + Math.random() * 3, ph2: Math.random() * TAU,
              v: (Math.random() < 0.5 ? -1 : 1) * (0.1 + Math.random() * 0.12),
              amp: 22 + Math.random() * 34,
              lw: Math.random() < 0.25 ? 1.6 : 1,
              col: `rgb(${Math.round(70 + 40 * c)}, ${Math.round(130 + 110 * c)}, ${Math.round(255 - 55 * c)})`,
              alpha: 0.11 + Math.random() * 0.13,
              glint: Math.random() < 0.35 ? { s: Math.random(), v: 0.02 + Math.random() * 0.025, r: 5 + Math.random() * 4 } : null,
            };
          });
          let w = 0, h = 0, motes = [], band, ampK = 1;
          const px = new Float32Array(M), py = new Float32Array(M), nx = new Float32Array(M), ny = new Float32Array(M), wide = new Float32Array(M);
          const smooth = (a, b, x) => { const q = Math.min(1, Math.max(0, (x - a) / (b - a))); return q * q * (3 - 2 * q); };
          const size = () => {
            w = cv.width = innerWidth;
            h = cv.height = innerHeight;
            // The stream's centre line: one cubic curve from above the top right, down and round into the bottom left.
            const P = [[w * 0.87, -h * 0.15], [w * 0.92, h * 0.80], [w * 0.78, h * 0.83], [w * -0.12, h * 0.79]];
            const top = Math.max(40, w * 0.13), mid = h * 0.06, end = h * 0.17;
            ampK = Math.min(1, 0.35 + w / 1500); // calmer waves on narrow screens
            for (let i = 0; i < M; i++) {
              const s = i / (M - 1), r = 1 - s;
              const b = [r * r * r, 3 * r * r * s, 3 * r * s * s, s * s * s];
              const db = [-3 * r * r, 3 * r * r - 6 * r * s, 6 * r * s - 3 * s * s, 3 * s * s];
              let x = 0, y = 0, tx = 0, ty = 0;
              for (let j = 0; j < 4; j++) { x += b[j] * P[j][0]; y += b[j] * P[j][1]; tx += db[j] * P[j][0]; ty += db[j] * P[j][1]; }
              const l = Math.hypot(tx, ty) || 1;
              px[i] = x; py[i] = y; nx[i] = -ty / l; ny[i] = tx / l;
              // Wide at the top, gathered at the bend, opening up again as it flows right.
              wide[i] = s < 0.55 ? top + (mid - top) * smooth(0, 0.55, s) : mid + (end - mid) * smooth(0.55, 1, s);
            }
            band = cx.createLinearGradient(0, h * 0.70, 0, h * 0.90);
            band.addColorStop(0, 'rgba(80, 230, 190, 0)');
            band.addColorStop(0.5, 'rgba(80, 230, 190, 1)');
            band.addColorStop(1, 'rgba(80, 230, 190, 0)');
            const n = Math.round(Math.min(70, (w * h) / 26000));
            motes = Array.from({ length: n }, () => ({
              x: Math.random() * w, y: Math.random() * h,
              vx: (Math.random() - 0.5) * 6, vy: -(3 + Math.random() * 9),
              r: 5 + Math.random() * 9, tw: Math.random() * TAU, ts: 0.6 + Math.random() * 1.4,
              gold: Math.random() < 0.18,
            }));
          };
          const draw = (t, dt) => {
            cx.clearRect(0, 0, w, h);
            cx.globalCompositeOperation = 'lighter';
            // Faint band of light under the lower flow, breathing slowly.
            cx.globalAlpha = 0.06 + 0.02 * Math.sin(t * 0.3);
            cx.fillStyle = band;
            cx.fillRect(0, h * 0.70, w, h * 0.2);
            cx.lineWidth = 1;
            const glints = [];
            for (const st of strands) {
              cx.strokeStyle = st.col;
              cx.globalAlpha = st.alpha;
              cx.lineWidth = st.lw;
              cx.beginPath();
              const gi = st.glint ? Math.floor(st.glint.s * (M - 1)) : -1;
              for (let i = 0; i < M; i++) {
                const s = i / (M - 1);
                // Shared slow sway, plus this strand's own wave that carries it across its neighbours.
                const d = st.k * wide[i]
                  + ampK * st.amp * Math.sin(s * st.f * TAU + t * st.v + st.ph)
                  + ampK * st.amp * 0.35 * Math.sin(s * st.f2 * TAU - t * st.v * 1.4 + st.ph2)
                  + 14 * Math.sin(s * 5 + t * 0.07);
                const x = px[i] + nx[i] * d, y = py[i] + ny[i] * d;
                i ? cx.lineTo(x, y) : cx.moveTo(x, y);
                if (i === gi) glints.push([x, y, st.glint.r]);
              }
              cx.stroke();
              if (st.glint) st.glint.s = (st.glint.s + st.glint.v * dt) % 1;
            }
            for (const [x, y, r] of glints) {
              cx.globalAlpha = 0.55;
              cx.drawImage(green, x - r, y - r, r * 2, r * 2);
            }
            for (const m of motes) {
              m.x += m.vx * dt; m.y += m.vy * dt;
              if (m.y < -20) { m.y = h + 20; m.x = Math.random() * w; }
              if (m.x < -20) m.x = w + 20; else if (m.x > w + 20) m.x = -20;
              cx.globalAlpha = 0.25 + 0.45 * (0.5 + 0.5 * Math.sin(t * m.ts + m.tw));
              cx.drawImage(m.gold ? lime : green, m.x - m.r, m.y - m.r, m.r * 2, m.r * 2);
            }
            cx.globalAlpha = 1;
            cx.globalCompositeOperation = 'source-over';
          };
          size();
          let rt;
          addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { size(); if (calm) draw(40, 0); }, 150); });
          if (calm) draw(40, 0);
          else {
            let last = 0, start = performance.now();
            const loop = (now) => {
              requestAnimationFrame(loop);
              if (now - last < 33) return;
              const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
              last = now;
              draw((now - start) / 1000, dt);
            };
            requestAnimationFrame(loop);
          }
        }

        // Item menu: pointing at a folder tab opens that file; clicking it goes to the page.
        const box = document.querySelector('.files');
        if (box) {
          document.documentElement.classList.add('js-files');
          const tabs = [...box.querySelectorAll('.file-tab')];
          const panels = [...box.querySelectorAll('.file-panel')];
          const open = (tab) => {
            if (!tab || tab.classList.contains('is-active')) return;
            const i = Number(tab.dataset.i);
            tabs.forEach((t, k) => t.classList.toggle('is-active', k === i));
            panels.forEach((p, k) => p.classList.toggle('is-active', k === i));
          };
          box.querySelector('.file-tabs').addEventListener('mouseover', (e) => open(e.target.closest('.file-tab')));
          box.querySelector('.file-tabs').addEventListener('focusin', (e) => open(e.target.closest('.file-tab')));
        }

        // One pointing hand per menu.
        const menus = [
          { box: document.querySelector('.site-nav'), home: 'a[aria-current="page"]', wide: '(min-width: 900px)' },
          { box: document.querySelector('.rpg-cmds'), home: 'a', wide: 'all' },
          { box: document.querySelector('.file-tabs'), home: 'a.is-active', wide: '(min-width: 761px)' },
        ];
        for (const m of menus) {
          if (!m.box) continue;
          const items = [...m.box.querySelectorAll('a')];
          const hand = document.createElement('span');
          hand.className = 'rpg-hand';
          hand.setAttribute('aria-hidden', 'true');
          m.box.appendChild(hand);
          const point = (a) => {
            items.forEach((x) => x.classList.toggle('is-pointed', x === a));
            if (!a || !matchMedia(m.wide).matches) { hand.style.opacity = '0'; return; }
            hand.style.opacity = '1';
            hand.style.transform = `translate(${a.offsetLeft - 40}px, ${a.offsetTop + a.offsetHeight / 2 - 10}px)`;
          };
          const home = () => point(m.home ? m.box.querySelector(m.home) : null);
          m.box.addEventListener('mouseover', (e) => { const a = e.target.closest('a'); if (a) point(a); });
          m.box.addEventListener('focusin', (e) => point(e.target.closest('a')));
          m.box.addEventListener('mouseleave', () => { if (!m.box.contains(document.activeElement)) home(); });
          m.box.addEventListener('focusout', () => setTimeout(() => { if (!m.box.contains(document.activeElement)) home(); }));
          m.box.addEventListener('keydown', (e) => {
            if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(e.key)) return;
            const i = items.indexOf(document.activeElement);
            if (i < 0) return;
            e.preventDefault();
            const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : -1;
            items[(i + step + items.length) % items.length].focus();
          });
          addEventListener('resize', home);
          (document.fonts?.ready ?? Promise.resolve()).then(() => { hand.classList.add('no-glide'); home(); requestAnimationFrame(() => hand.classList.remove('no-glide')); });
          home();
        }

        if (!calm) {
          document.querySelector('.site-nav')?.addEventListener('click', (e) => {
            const a = e.target.closest('a');
            if (!a || e.ctrlKey || e.metaKey || e.shiftKey || a.hash || a.origin !== location.origin) return;
            e.preventDefault();
            document.documentElement.classList.add('rpg-leaving');
            setTimeout(() => { location.href = a.href; }, 260);
          });
          addEventListener('pageshow', () => document.documentElement.classList.remove('rpg-leaving'));
        }

        if (!('IntersectionObserver' in window) || calm) return;
        const targets = document.querySelectorAll('main h2, main .files, main .video, main section > p:not(.rpg-message)');
        targets.forEach((el) => el.classList.add('reveal'));
        document.documentElement.classList.add('reveal-ready');
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
