---
// Site layout: the RPG menu theme. Side menu with the contact block at its foot (a fold-out menu on phones),
// living background, and the page script that drives them.
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/theme.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site.mjs';
import { games } from '../data/games.mjs';
import ContactLinks from '../components/ContactLinks.astro';

interface Props {
  title?: string;
  description?: string;
  // Picture for link previews. Game and project pages pass their cover; the rest use /og.jpg.
  image?: ImageMetadata;
}

const { title, description = site.description, image } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.headline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Link previews (LinkedIn, WhatsApp, X): absolute URLs built from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// A cover is cut to 1200 × 630, the size LinkedIn and WhatsApp expect, and saved as a light JPG.
const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src, Astro.site).href
  : new URL('/og.jpg', Astro.site).href;
const ogAlt = image && title ? `${title} — ${site.name}` : `${site.name} — ${site.headline}`;
// Main menu. Games carries a submenu that shows only while you are inside that section
// (the page script below opens and closes it as pages change, since the menu itself is not redrawn).
const nav = [
  { href: '/', label: 'Home' },
  { href: '/games/', label: 'Games', group: 'games' },
  ...games.map((g) => ({ href: g.href, label: g.navLabel ?? g.title, sub: 'games' })),
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
const trim = (href: string) => href.split('#')[0].replace(/\/$/, '') || '/';
// "page" on the exact page (the hand rests there), "true" on a section that contains it.
const currentOf = (href: string, isSub = false) => {
  if (href.includes('#')) return undefined;
  const h = trim(href);
  if (h === path) return 'page';
  if (!isSub && h !== '/' && path.startsWith(h + '/')) return 'true';
  return undefined;
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Colour of the browser bar on phones: the page background. -->
    <meta name="theme-color" content="#050b1c" />
    <!-- Fonts are self-hosted (src/styles/fonts.css); preload the latin files the first screen uses -->
    <link rel="preload" href="/fonts/oxanium-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js-nav');</script>
    <!-- Pages swap in place, so the menu and the background keep running between them. -->
    <ClientRouter />
  </head>
  <body>
    <!-- Keyboard and screen-reader users jump past the menu. Hidden until it gets focus. -->
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- Living background: a slow drifting glow, faint diagonal lines, fine light strands and motes drawn on a canvas,
         and a sheen that crosses the screen every 20 seconds. Decorative; it keeps running while pages change.
         With reduced motion the canvas draws one still frame and nothing else moves. -->
    <div class="rpg-fx" aria-hidden="true" transition:persist="fx"><i></i><span class="rpg-lines"></span><canvas></canvas><span class="rpg-sheen"></span></div>
    <header class="site-header" transition:persist="menu">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <button type="button" class="nav-toggle" aria-controls="nav-panel" aria-expanded="false">
          <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span><span>Menu</span>
        </button>
        <div class="nav-panel" id="nav-panel">
          <nav class="site-nav" aria-label="Main">
            {nav.map((item) => item.sub ? (
              <a class="sub" href={item.href} data-sub={item.sub} hidden={!path.startsWith('/' + item.sub)} aria-current={currentOf(item.href, true)}>{item.label}</a>
            ) : (
              <a href={item.href} aria-current={currentOf(item.href)}>{item.label}</a>
            ))}
          </nav>
          <div class="rpg-contact">
            <p class="rpg-contact-title">Contact</p>
            <p class="contact-loc">Based in {site.location}. Open to remote roles and relocation.</p>
            <ContactLinks />
          </div>
        </div>
        <!-- Below 1180px the sections are also a row of tabs under the name, so moving between pages needs no menu. -->
        <nav class="tab-nav" aria-label="Sections">
          {nav.filter((item) => !item.sub).map((item) => (
            <a href={item.href} aria-current={currentOf(item.href)}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <!-- Below 1180px the contact block is folded inside the Menu button, so the links are repeated here.
             Home already shows them under the intro, so its footer leaves them out. -->
        {path !== '/' && <nav class="contact-quick" aria-label="Contact"><ContactLinks /></nav>}
        <span>{site.name} · {site.headline}</span>
      </div>
    </footer>
    <!-- Enlarged image, opened by the page script when an image in a page is clicked. -->
    <dialog class="lightbox" aria-label="Enlarged image">
      <div class="lightbox-stage">
        <img alt="" />
        <button type="button" class="lightbox-nav prev" aria-label="Previous image">◀</button>
        <button type="button" class="lightbox-nav next" aria-label="Next image">▶</button>
      </div>
      <div class="lightbox-bar">
        <span class="lightbox-count" aria-live="polite"></span>
        <button type="button" class="lightbox-close" aria-label="Close">Close</button>
      </div>
    </dialog>
    <script is:inline>
      // The menu and the living background stay in place while pages change (see ClientRouter and transition:persist
      // above), so their setup runs once. What belongs to a page is set up again on every astro:page-load.
      (() => {
        if (window.__rpgSite) return;
        window.__rpgSite = true;
        const root = document.documentElement;
        const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ---------- Once: menu ----------
        const bar = document.querySelector('.site-header .wrap');
        const nav = bar?.querySelector('.site-nav');
        const btn = bar?.querySelector('.nav-toggle');
        // Phones: the menu and the contact block fold into a button on a bar that stays at the top of the screen.
        const setNav = (open) => { root.classList.toggle('nav-open', open); btn?.setAttribute('aria-expanded', String(open)); };
        if (bar && nav && btn) {
          btn.addEventListener('click', () => setNav(!root.classList.contains('nav-open')));
          nav.addEventListener('click', (e) => { if (e.target.closest('a')) setNav(false); });
          addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.classList.contains('nav-open')) { setNav(false); btn.focus(); } });
          document.addEventListener('click', (e) => { if (!bar.contains(e.target)) setNav(false); });
        }
        // A page swap replaces the classes on <html>; put this one back before the new page paints.
        document.addEventListener('astro:after-swap', () => root.classList.add('js-nav'));

        // The background is carried into the next page, and a CSS animation starts over when its element is moved.
        // Put each one back where it was (a negative delay), so the sheen keeps its own clock and never fires on a page change.
        const born = performance.now();
        const loops = [['.rpg-sheen', 20], ['.rpg-lines', 60], ['.rpg-fx i', 76]]; // selector, seconds per full cycle
        document.addEventListener('astro:after-swap', () => {
          const t = (performance.now() - born) / 1000;
          for (const [sel, len] of loops) {
            const el = document.querySelector(sel);
            if (el) el.style.animationDelay = -(t % len) + 's';
          }
        });

        // One pointing hand per menu: it rests on the menu's home item and follows the pointer and the keyboard.
        const handFor = (box, homeSel, wide, signal) => {
          const items = [...box.querySelectorAll('a')];
          const hand = document.createElement('span');
          hand.className = 'rpg-hand';
          hand.setAttribute('aria-hidden', 'true');
          box.appendChild(hand);
          const point = (a) => {
            items.forEach((x) => x.classList.toggle('is-pointed', x === a));
            if (!a || !matchMedia(wide).matches) { hand.style.opacity = '0'; return; }
            hand.style.opacity = '1';
            hand.style.transform = `translate(${a.offsetLeft - 40}px, ${a.offsetTop + a.offsetHeight / 2 - 10}px)`;
          };
          // homeSel may list fallbacks with "||": the first selector that matches wins.
          const home = () => point(homeSel.split('||').map((s) => box.querySelector(s.trim())).find(Boolean) ?? null);
          const on = (target, type, fn) => target.addEventListener(type, fn, { signal });
          on(box, 'mouseover', (e) => { const a = e.target.closest('a'); if (a) point(a); });
          on(box, 'focusin', (e) => point(e.target.closest('a')));
          on(box, 'mouseleave', () => { if (!box.contains(document.activeElement)) home(); });
          on(box, 'focusout', () => setTimeout(() => { if (!box.contains(document.activeElement)) home(); }));
          on(box, 'keydown', (e) => {
            if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(e.key)) return;
            const shown = items.filter((x) => !x.hidden);
            const i = shown.indexOf(document.activeElement);
            if (i < 0) return;
            e.preventDefault();
            const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : -1;
            shown[(i + step + shown.length) % shown.length].focus();
          });
          on(window, 'resize', home);
          (document.fonts?.ready ?? Promise.resolve()).then(() => { hand.classList.add('no-glide'); home(); requestAnimationFrame(() => hand.classList.remove('no-glide')); });
          home();
          return home;
        };
        // The hand rests on this exact page or, on a page the menu does not list (a project breakdown), on its section.
        const navHome = nav ? handFor(nav, 'a[aria-current="page"] || a[aria-current]', '(min-width: 1180px)') : () => {};

        // ---------- Once: living background ----------
        // Background: a few ribbons of thin green strands that undulate across the screen, and green motes
        // that drift up and twinkle. Drawn at CSS-pixel resolution and paced at ~24 fps to stay light.
        const cv = document.querySelector('.rpg-fx canvas');
        const cx = cv?.getContext('2d');
        if (cx) {
          const TAU = Math.PI * 2;
          // Glow sprite for the motes, drawn once and stamped many times.
          const makeSprite = (core, mid, edge) => {
            const c = document.createElement('canvas');
            c.width = c.height = 32;
            const g2 = c.getContext('2d');
            const g = g2.createRadialGradient(16, 16, 0, 16, 16, 16);
            g.addColorStop(0, core);
            g.addColorStop(0.18, mid);
            g.addColorStop(0.45, edge);
            g.addColorStop(1, 'rgba(0, 0, 0, 0)');
            g2.fillStyle = g;
            g2.fillRect(0, 0, 32, 32);
            return c;
          };
          const green = makeSprite('rgba(225, 255, 235, 1)', 'rgba(120, 255, 180, 0.9)', 'rgba(60, 220, 150, 0.25)');
          const lime = makeSprite('rgba(250, 255, 220, 1)', 'rgba(210, 245, 110, 0.85)', 'rgba(170, 220, 60, 0.2)');

          // A stream of fine light strands, like a loose bundle of fibre: it rises along the right side, bends in
          // the lower right and flows out to the left near the bottom. Every strand follows the same path with its
          // own place in the bundle and its own wave, so strands drift across each other and cross again without
          // tangling. A few glints travel along the strands, and a faint band of light marks the lower flow.
          const N = 26, M = 110;
          const strands = Array.from({ length: N }, (_, i) => {
            const c = Math.random(); // colour: 0 = blue, 1 = sea green
            return {
              k: i / (N - 1) - 0.5,
              ph: Math.random() * TAU,
              f: 2 + Math.random() * 2.2,
              f2: 4.5 + Math.random() * 3, ph2: Math.random() * TAU,
              v: (Math.random() < 0.5 ? -1 : 1) * (0.1 + Math.random() * 0.12),
              amp: 22 + Math.random() * 34,
              lw: Math.random() < 0.25 ? 1.6 : 1,
              col: `rgb(${Math.round(70 + 40 * c)}, ${Math.round(130 + 110 * c)}, ${Math.round(255 - 55 * c)})`,
              alpha: 0.11 + Math.random() * 0.13,
              glint: Math.random() < 0.35 ? { s: Math.random(), v: 0.02 + Math.random() * 0.025, r: 5 + Math.random() * 4 } : null,
            };
          });
          let w = 0, h = 0, motes = [], band, ampK = 1;
          const px = new Float32Array(M), py = new Float32Array(M), nx = new Float32Array(M), ny = new Float32Array(M), wide = new Float32Array(M);
          const smooth = (a, b, x) => { const q = Math.min(1, Math.max(0, (x - a) / (b - a))); return q * q * (3 - 2 * q); };
          const size = () => {
            w = cv.width = innerWidth;
            h = cv.height = innerHeight;
            // The stream's centre line: one cubic curve from above the top right, down and round into the bottom left.
            const P = [[w * 0.87, -h * 0.15], [w * 0.92, h * 0.80], [w * 0.78, h * 0.83], [w * -0.12, h * 0.79]];
            const top = Math.max(40, w * 0.13), mid = h * 0.06, end = h * 0.17;
            ampK = Math.min(1, 0.35 + w / 1500); // calmer waves on narrow screens
            for (let i = 0; i < M; i++) {
              const s = i / (M - 1), r = 1 - s;
              const b = [r * r * r, 3 * r * r * s, 3 * r * s * s, s * s * s];
              const db = [-3 * r * r, 3 * r * r - 6 * r * s, 6 * r * s - 3 * s * s, 3 * s * s];
              let x = 0, y = 0, tx = 0, ty = 0;
              for (let j = 0; j < 4; j++) { x += b[j] * P[j][0]; y += b[j] * P[j][1]; tx += db[j] * P[j][0]; ty += db[j] * P[j][1]; }
              const l = Math.hypot(tx, ty) || 1;
              px[i] = x; py[i] = y; nx[i] = -ty / l; ny[i] = tx / l;
              // Wide at the top, gathered at the bend, opening up again as it flows right.
              wide[i] = s < 0.55 ? top + (mid - top) * smooth(0, 0.55, s) : mid + (end - mid) * smooth(0.55, 1, s);
            }
            band = cx.createLinearGradient(0, h * 0.70, 0, h * 0.90);
            band.addColorStop(0, 'rgba(80, 230, 190, 0)');
            band.addColorStop(0.5, 'rgba(80, 230, 190, 1)');
            band.addColorStop(1, 'rgba(80, 230, 190, 0)');
            const n = Math.round(Math.min(70, (w * h) / 26000));
            motes = Array.from({ length: n }, () => ({
              x: Math.random() * w, y: Math.random() * h,
              vx: (Math.random() - 0.5) * 6, vy: -(3 + Math.random() * 9),
              r: 5 + Math.random() * 9, tw: Math.random() * TAU, ts: 0.6 + Math.random() * 1.4,
              gold: Math.random() < 0.18,
            }));
          };
          const draw = (t, dt) => {
            cx.clearRect(0, 0, w, h);
            cx.globalCompositeOperation = 'lighter';
            // Faint band of light under the lower flow, breathing slowly.
            cx.globalAlpha = 0.06 + 0.02 * Math.sin(t * 0.3);
            cx.fillStyle = band;
            cx.fillRect(0, h * 0.70, w, h * 0.2);
            cx.lineWidth = 1;
            const glints = [];
            for (const st of strands) {
              cx.strokeStyle = st.col;
              cx.globalAlpha = st.alpha;
              cx.lineWidth = st.lw;
              cx.beginPath();
              const gi = st.glint ? Math.floor(st.glint.s * (M - 1)) : -1;
              for (let i = 0; i < M; i++) {
                const s = i / (M - 1);
                // Shared slow sway, plus this strand's own wave that carries it across its neighbours.
                const d = st.k * wide[i]
                  + ampK * st.amp * Math.sin(s * st.f * TAU + t * st.v + st.ph)
                  + ampK * st.amp * 0.35 * Math.sin(s * st.f2 * TAU - t * st.v * 1.4 + st.ph2)
                  + 14 * Math.sin(s * 5 + t * 0.07);
                const x = px[i] + nx[i] * d, y = py[i] + ny[i] * d;
                i ? cx.lineTo(x, y) : cx.moveTo(x, y);
                if (i === gi) glints.push([x, y, st.glint.r]);
              }
              cx.stroke();
              if (st.glint) st.glint.s = (st.glint.s + st.glint.v * dt) % 1;
            }
            for (const [x, y, r] of glints) {
              cx.globalAlpha = 0.55;
              cx.drawImage(green, x - r, y - r, r * 2, r * 2);
            }
            for (const m of motes) {
              m.x += m.vx * dt; m.y += m.vy * dt;
              if (m.y < -20) { m.y = h + 20; m.x = Math.random() * w; }
              if (m.x < -20) m.x = w + 20; else if (m.x > w + 20) m.x = -20;
              cx.globalAlpha = 0.25 + 0.45 * (0.5 + 0.5 * Math.sin(t * m.ts + m.tw));
              cx.drawImage(m.gold ? lime : green, m.x - m.r, m.y - m.r, m.r * 2, m.r * 2);
            }
            cx.globalAlpha = 1;
            cx.globalCompositeOperation = 'source-over';
          };
          size();
          // Runs at ~24 fps (frames are paced on a schedule, so 60 and 120 Hz screens both average 24).
          // It stops while the tab is hidden and resumes where it left off, and it follows the reduced-motion
          // setting live: turned on, the canvas holds one still frame; turned off, the animation starts again.
          const still = matchMedia('(prefers-reduced-motion: reduce)');
          const STEP = 1000 / 24;
          let raf = 0, last = 0, next = 0, t = 0;
          const loop = (now) => {
            raf = requestAnimationFrame(loop);
            if (now < next - 2) return;
            next = (next && now - next < 100 ? next : now) + STEP;
            const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
            last = now; t += dt;
            draw(t, dt);
          };
          const run = () => {
            const go = !still.matches && !document.hidden;
            if (go && !raf) { last = next = 0; raf = requestAnimationFrame(loop); }
            else if (!go && raf) { cancelAnimationFrame(raf); raf = 0; }
            if (still.matches) draw(40, 0);
          };
          let rt;
          addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { size(); if (!raf) draw(still.matches ? 40 : t, 0); }, 150); });
          document.addEventListener('visibilitychange', run);
          still.addEventListener('change', run);
          run();
        }

        // ---------- Every page ----------
        let pageEnd;
        const page = () => {
          pageEnd?.abort();
          pageEnd = new AbortController();
          const signal = pageEnd.signal;
          root.classList.add('js-nav');
          setNav(false);
          // Links to other sites open in a new tab, so the visitor keeps the portfolio open.
          document.querySelectorAll('a[href^="http"]').forEach((a) => {
            if (a.host === location.host) return;
            a.target = '_blank';
            a.rel = 'noopener';
          });

          // The menu is not redrawn, so mark the current page here and open the submenu of the current section;
          // the hand glides to the page. "page" = this exact page, "true" = the section that contains it.
          const here = location.pathname.replace(/\/$/, '') || '/';
          document.querySelectorAll('.site-nav a, .tab-nav a').forEach((a) => {
            const u = new URL(a.href);
            const h = u.pathname.replace(/\/$/, '') || '/';
            const sub = a.dataset.sub;
            if (sub) a.hidden = !here.startsWith('/' + sub);
            let cur = null;
            if (!u.hash && h === here) cur = 'page';
            else if (!sub && h !== '/' && here.startsWith(h + '/')) cur = 'true';
            if (cur) a.setAttribute('aria-current', cur);
            else a.removeAttribute('aria-current');
          });
          navHome();

          // Item menu: pointing at an entry opens that file; clicking it goes to the page.
          const box = document.querySelector('.files');
          root.classList.toggle('js-files', !!box);
          if (box) {
            const tabs = [...box.querySelectorAll('.file-tab')];
            const panels = [...box.querySelectorAll('.file-panel')];
            const open = (tab) => {
              if (!tab || tab.classList.contains('is-active')) return;
              const i = Number(tab.dataset.i);
              tabs.forEach((t, k) => t.classList.toggle('is-active', k === i));
              panels.forEach((p, k) => p.classList.toggle('is-active', k === i));
            };
            const list = box.querySelector('.file-tabs');
            list.addEventListener('mouseover', (e) => open(e.target.closest('.file-tab')));
            list.addEventListener('focusin', (e) => open(e.target.closest('.file-tab')));
            handFor(list, 'a.is-active', '(min-width: 761px)', signal);
          }

          // Images inside a page open enlarged on click.
          const lb = document.querySelector('.lightbox');
          if (lb && lb.showModal) {
            const big = lb.querySelector('img');
            const count = lb.querySelector('.lightbox-count');
            // Only this page's images, in page order; the arrows go round from the last back to the first.
            // Images inside a link or a button (the YouTube thumbnail) already do something else when clicked.
            const pics = [...document.querySelectorAll('article img')].filter((im) => !im.closest('a, button'));
            let at = 0, ask = 0;
            // The largest version on offer, not the thumbnail the page picked, and its width in pixels.
            const full = (im) => {
              const last = (im.srcset || '').split(',').pop().trim().split(/\s+/);
              return { url: last[0] || im.currentSrc || im.src, w: parseInt(last[1], 10) || im.naturalWidth || 1920 };
            };
            // Large versions already asked for, kept so the browser holds them ready.
            const warm = new Map();
            const fetchFull = (url) => {
              let p = warm.get(url);
              if (!p) { p = new Image(); p.decoding = 'async'; p.src = url; warm.set(url, p); }
              return p;
            };
            const show = (i) => {
              at = (i + pics.length) % pics.length;
              const im = pics[at], f = full(im), n = ++ask;
              // The box keeps its last image between openings. Until the large version is ready, show this page's
              // own (already loaded) thumbnail at the final size, so the previous picture never flashes up.
              big.style.setProperty('--ar', (im.naturalWidth / im.naturalHeight) || 16 / 9);
              big.style.setProperty('--fw', f.w + 'px');
              big.alt = im.alt;
              count.textContent = pics.length > 1 ? (at + 1) + ' / ' + pics.length : '';
              const p = fetchFull(f.url);
              if (p.complete && p.naturalWidth) big.src = f.url;
              else {
                big.src = im.currentSrc || im.src;
                // Only the latest request may swap in, so a slow download never replaces a newer image.
                p.decode().catch(() => {}).then(() => { if (n === ask) big.src = f.url; });
              }
              // Fetch the neighbours too, so the arrows answer at once.
              if (pics.length > 1) { fetchFull(full(pics[(at + 1) % pics.length]).url); fetchFull(full(pics[(at - 1 + pics.length) % pics.length]).url); }
            };
            lb.classList.toggle('single', pics.length < 2);
            pics.forEach((im, i) => {
              im.classList.add('zoomable');
              im.tabIndex = 0;
              im.setAttribute('role', 'button');
              im.setAttribute('aria-label', 'Enlarge image: ' + im.alt);
              const open = () => { show(i); lb.showModal(); };
              im.addEventListener('click', open);
              im.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
            });
            const on = (target, type, fn, opts) => target.addEventListener(type, fn, { signal, ...opts });
            const step = (e, d) => { e.stopPropagation(); if (pics.length > 1) show(at + d); };
            on(lb.querySelector('.lightbox-nav.prev'), 'click', (e) => step(e, -1));
            on(lb.querySelector('.lightbox-nav.next'), 'click', (e) => step(e, 1));
            on(lb, 'keydown', (e) => {
              if (e.key === 'ArrowLeft') step(e, -1);
              else if (e.key === 'ArrowRight') step(e, 1);
            });
            // A sideways swipe changes image; the tap that ends it must not also close the box.
            let x0 = null, y0 = 0, swiped = false;
            on(lb, 'touchstart', (e) => { const t = e.touches[0]; x0 = e.touches.length === 1 ? t.clientX : null; y0 = t.clientY; }, { passive: true });
            on(lb, 'touchend', (e) => {
              if (x0 === null) return;
              const t = e.changedTouches[0], dx = t.clientX - x0, dy = t.clientY - y0;
              x0 = null;
              if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
                swiped = true;
                if (e.cancelable) e.preventDefault();
                step(e, dx < 0 ? 1 : -1);
              }
            });
            on(lb, 'click', () => { if (swiped) { swiped = false; return; } lb.close(); });
            on(lb, 'close', () => { swiped = false; });
          }

          // Sections come in as they are scrolled to.
          if (!('IntersectionObserver' in window) || calm) return;
          const targets = document.querySelectorAll('main h2, main .files, main .video, main section > p:not(.rpg-message)');
          targets.forEach((el) => el.classList.add('reveal'));
          root.classList.add('reveal-ready');
          const io = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); }
            }
          }, { rootMargin: '0px 0px -8% 0px' });
          targets.forEach((el) => io.observe(el));
          signal.addEventListener('abort', () => io.disconnect());
        };
        document.addEventListener('astro:page-load', page);
      })();
    </script>
  </body>
</html>
