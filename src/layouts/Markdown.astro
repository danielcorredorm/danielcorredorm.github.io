---
// Layout for the Markdown pages (games, projects, about).
// Frontmatter: title, description, tagline. A page with `facts` (label → value) is a game or project file and
// gets the same top: facts beside a small video (when there is one), then a gallery of up to four screenshots.
// Optional: `video` (YouTube id), `videoTitle`, `videoNote` (caption under the video), `source` (repository link,
// shown as a button beside the title). Images come from src/assets/media/<slug>/.
import { Image } from 'astro:assets';
import Site from './Site.astro';
import YouTube from '../components/YouTube.astro';
import { mediaFor, slugOf, SHOTS } from '../data/media.mjs';
import { games } from '../data/games.mjs';

const { frontmatter } = Astro.props;
// Game pages end with links to the previous and next game, in the order of the Games page (it wraps around).
const here = Astro.url.pathname.replace(/\/?$/, '/');
const gi = games.findIndex((g) => g.href === here);
const short = (g: { title: string; navLabel?: string }) => g.navLabel ?? g.title;
const prevGame = gi >= 0 ? games[(gi - 1 + games.length) % games.length] : null;
const nextGame = gi >= 0 ? games[(gi + 1) % games.length] : null;
// A project breakdown ends with a way back to the full list of projects.
const isProjectPage = here.startsWith('/projects/') && here !== '/projects/';
const facts: Record<string, string> = frontmatter.facts ?? {};
const isFile = Object.keys(facts).length > 0;
const media = mediaFor(slugOf(Astro.url.pathname));
const shots = media.shots.slice(0, SHOTS).map((s) => s.img);
---
<Site title={frontmatter.title} description={frontmatter.description}>
  <article>
    <header class="page-head">
      <div>
        <h1>{frontmatter.title}</h1>
        {frontmatter.tagline && <p class="tagline">{frontmatter.tagline}</p>}
      </div>
      {frontmatter.source && <a class="src-btn" href={frontmatter.source}>Source on GitHub</a>}
    </header>
    {isFile && (
      <div class:list={['file-top', { solo: !frontmatter.video }]}>
        <dl class="facts">
          {Object.entries(facts).map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd set:html={v} />
            </>
          ))}
        </dl>
        {frontmatter.video && (
          <div class="file-media">
            <YouTube id={frontmatter.video} title={frontmatter.videoTitle ?? frontmatter.title} />
            {frontmatter.videoNote && <p class="media-note">{frontmatter.videoNote}</p>}
          </div>
        )}
      </div>
    )}
    {isFile && media.shots.length > 0 && (
      <ul class="gallery" aria-label="Screenshots">
        {shots.map((img, i) => (
          <li>
            <Image src={img} alt={`${frontmatter.title}, screenshot ${i + 1}`} widths={[480, 1920]} sizes="(max-width: 700px) 50vw, 240px" />
          </li>
        ))}
      </ul>
    )}
    <slot />
    {prevGame && nextGame && (
      <nav class="game-step" aria-label="More games">
        <a class="prev" href={prevGame.href} rel="prev"><span>Previous game</span><b>{short(prevGame)}</b></a>
        <a class="next" href={nextGame.href} rel="next"><span>Next game</span><b>{short(nextGame)}</b></a>
      </nav>
    )}
    {isProjectPage && (
      <nav class="game-step" aria-label="More projects">
        <a class="prev" href="/projects/"><span>Back to</span><b>All projects</b></a>
      </nav>
    )}
  </article>
</Site>
