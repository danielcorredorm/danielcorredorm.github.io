---
// Home: a character-menu hero (figure, name set vertically, one big stat, status text and commands) and the
// featured work as an item menu: folder tabs on the left, the pointed file open on the right.
// Without JS, and on phones, every file shows. The theme and the page script live in layouts/Site.astro.
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import YouTube from '../components/YouTube.astro';
import { site } from '../data/site.mjs';
import { games } from '../data/games.mjs';
import bodyGlow from '../assets/daniel-body-glow.webp'; // cut-out with a soft blue halo, made by Daniel

const files = [
  {
    href: '/projects/ils-demo/',
    title: 'GAS action-combat demo (ILS_Demo)',
    short: 'GAS combat demo',
    meta: 'Technical breakdown · UE 5.4 · C++',
    summary: 'Data-driven ability sets, abilities bound to input by Gameplay Tag, a custom root-motion dash task, combo windows driven by an AnimNotifyState, and ability costs from a Magnitude Calculation.',
  },
  ...games.map((g) => ({ ...g, short: g.title.replace(/:.*$/, '') })),
];
const [firstName, ...restName] = site.name.split(' ');
const pad = (n: number) => String(n).padStart(2, '0');
---
<Site>
  <section class="hero rpg-battle" aria-labelledby="char-name">
    <!-- Character card, as in a party menu: the figure, the name running down its side, and one big stat at its feet. -->
    <div class="char">
      <div class="char-fig">
        <Image class="char-img char-glow" src={bodyGlow} alt="Daniel Corredor" width={600} loading="eager" />
      </div>
      <h1 id="char-name" class="char-name"><span>{firstName}</span> <small>{restName.join(' ')}</small></h1>
      <p class="char-level"><span>Experience</span><strong>5+</strong><em>years</em></p>
    </div>
    <div class="rpg-status">
      <p class="kicker">Party · Active member</p>
      <p class="tagline">{site.headline}</p>
      <dl class="rpg-stats">
        <div><dt>Engine</dt><dd>Unreal Engine 4 / 5</dd></div>
        <div><dt>Languages</dt><dd>C++ · Blueprint</dd></div>
        <div><dt>Shipped</dt><dd>Multiplayer AA title</dd></div>
      </dl>
      <div class="rpg-atb" aria-hidden="true"><span>Ready</span><i></i></div>
    </div>
    <p class="lead rpg-message">
      5+ years building C++ and Blueprint gameplay systems in Unreal Engine 4 and 5.
      Shipped a multiplayer AA title, <a href="/games/killer-klowns/">Killer Klowns From Outer Space: The Game</a>.
      I specialize in the Gameplay Ability System (GAS), multiplayer network replication,
      combat and AI mechanics, and performance optimization.
    </p>
    <nav class="rpg-cmds" aria-label="Commands">
      <a href="#work">Featured work</a>
      <a href="/projects/">All projects</a>
      <a href={`mailto:${site.email}`}>Email me</a>
    </nav>
  </section>

  {site.reelId && (
    <section aria-labelledby="reel">
      <h2 id="reel">Demo reel</h2>
      <YouTube id={site.reelId} title="Daniel Corredor — Gameplay programming reel" />
    </section>
  )}

  <section aria-labelledby="work">
    <h2 id="work">Featured work</h2>
    <div class="files">
      <nav class="file-tabs" aria-label="Featured work">
        {files.map((f, i) => (
          <a class:list={['file-tab', { 'is-active': i === 0 }]} href={f.href} data-i={i}>
            <span class="file-no">{pad(i + 1)}</span>
            <span class="file-name">{f.short}</span>
          </a>
        ))}
      </nav>
      <div class="file-panels">
        {files.map((f, i) => (
          <article class:list={['file-panel', { 'is-active': i === 0 }]} data-i={i}>
            <span class="file-mark" aria-hidden="true">{pad(i + 1)}</span>
            <p class="meta">{f.meta}</p>
            <h3><a href={f.href}>{f.title}</a></h3>
            <p class="file-summary">{f.summary}</p>
            <a class="file-open" href={f.href} aria-hidden="true" tabindex="-1">Open file</a>
          </article>
        ))}
      </div>
    </div>
    <p class="files-more"><a href="/projects/">All projects →</a></p>
  </section>
</Site>
