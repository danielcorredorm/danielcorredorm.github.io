---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import { site } from '../data/site.mjs';
import { games } from '../data/games.mjs';
import portrait from '../assets/daniel.jpg';
---
<Base>
  <section class="hero">
    <Image class="portrait" src={portrait} alt="Daniel Corredor" width={320} height={320} loading="eager" />
    <div>
      <h1>{site.name}</h1>
      <p class="tagline">{site.headline}</p>
      <p class="lead">
        5+ years building C++ and Blueprint gameplay systems in Unreal Engine 4 and 5.
        Shipped a multiplayer AA title, <a href="/games/killer-klowns/">Killer Klowns From Outer Space: The Game</a>.
        I specialize in the Gameplay Ability System (GAS), multiplayer network replication,
        combat and AI mechanics, and performance optimization.
      </p>
      <p class="actions">
        <a class="button primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="button" href={site.links.linkedin}>LinkedIn</a>
        <a class="button" href={site.links.github}>GitHub</a>
      </p>
    </div>
  </section>

  {site.reelId && (
    <section aria-labelledby="reel">
      <h2 id="reel">Demo reel</h2>
      <YouTube id={site.reelId} title="Daniel Corredor — Gameplay programming reel" />
    </section>
  )}

  <section aria-labelledby="work">
    <h2 id="work">Featured work</h2>
    <div class="cards cols-2">
      <a class="card featured" href="/projects/ils-demo/">
        <div class="meta">Technical breakdown · UE 5.4 · C++</div>
        <h3>GAS action-combat demo (ILS_Demo)</h3>
        <p>Data-driven ability sets, abilities bound to input by Gameplay Tag, a custom root-motion dash task, combo windows driven by an AnimNotifyState, and ability costs from a Magnitude Calculation.</p>
      </a>
      {games.map((g) => (
        <a class="card" href={g.href}>
          <div class="meta">{g.meta}</div>
          <h3>{g.title}</h3>
          <p>{g.summary}</p>
        </a>
      ))}
    </div>
    <p><a href="/projects/">All projects →</a></p>
  </section>

  <section aria-labelledby="contact">
    <h2 id="contact">Contact</h2>
    <p>Based in {site.location}. Open to remote roles and relocation.</p>
    <ul class="contact">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.links.linkedin}>LinkedIn</a></li>
      <li><a href={site.links.github}>GitHub</a></li>
      <li><a href={site.links.itch}>itch.io</a></li>
    </ul>
  </section>
</Base>
